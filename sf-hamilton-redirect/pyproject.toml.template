# build.sh renders the redirect's pyproject.toml from pyproject.toml.template with
# scripts/render_redirect_pyproject.py, which fills in the placeholders and the extras.

[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "sf-hamilton"
version = "VERSION"
description = "This package has moved to SOURCE_NAME. Install SOURCE_NAME instead."
readme = "README.md"
requires-python = "REQUIRES_PYTHON"
license = "Apache-2.0"
dependencies = ["SOURCE_NAME==VERSION"]

[project.urls]
Homepage = "https://github.com/apache/hamilton"
Documentation = "https://hamilton.apache.org/"
